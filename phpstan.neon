includes:
    - vendor/pollora/harness/presets/phpstan/base.neon

parameters:
    level: max
    paths:
        - src
    # The WordPress stubs are only read, not run: illuminate/support (dev) declares helpers of its own,
    # and running the stubs after them could end in a "Cannot redeclare".
    bootstrapFiles!:
        - vendor/szepeviktor/phpstan-wordpress/bootstrap.php
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - vendor/wpsyntex/polylang-stubs/polylang-stubs.php
        # Contact Form 7 publishes no stubs: the little the package reads of it
        - tests/Stubs/phpstan/contact-form-7.php
    ignoreErrors:
        # Action Scheduler is a plugin, not part of the WordPress stubs: the package uses its functions only after checking they exist
        - '#Function (as_[a-z_]+|get_graphql_setting) not found#'
        # WPGraphQL is a plugin too: its error class exists only while it is active, and the guard runs from its own filter
        - '#GraphQL\\Error\\UserError#'
    # Only the patterns still needed are listed: report one that no longer matches, so it is removed
    reportUnmatchedIgnoredErrors: true
